# Copy this file to .env.local for local development and replace placeholders.
# Do not put real credentials in this example file.
# Vite embeds every VITE_* value in the browser bundle; these are not private secrets.

# Required: Supabase connection and sign-in/sign-up.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key

# Active: past-question metadata and questions from past-questions-api.onrender.com.
# This value is exposed to users by the current frontend implementation.
VITE_PUBLIC_BEARER_TOKEN=your_public_or_restricted_past_questions_token

# Active: Gemini quiz generation, analysis, and recommendations.
# The current frontend exposes this key to users. Use a restricted key only;
# move Gemini requests to a server before using a private production credential.
VITE_MY_API_KEY=your_restricted_gemini_api_key

# Legacy/optional: the unused fetchPastQuestions function in services/apiService.ts.
VITE_BEARER_TOKEN=your_public_or_restricted_aloc_bearer_token

# Legacy/optional: vite.config.ts defines process.env.API_KEY from this value,
# but the current Gemini service reads VITE_MY_API_KEY instead.
GEMINI_API_KEY=your_restricted_gemini_api_key

# NEXT_PUBLIC_BEARER_TOKEN is mentioned as a fallback in services/apiService.ts,
# but Vite does not expose NEXT_PUBLIC_* through import.meta.env by default.
# Use VITE_BEARER_TOKEN for that legacy function instead.
